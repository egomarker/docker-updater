<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.example.host-updater</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/host-updater</string>
      <string>-config</string>
      <string>/Users/you/Library/Application Support/host-updater/config.json</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/you/Library/Application Support/host-updater</string>

    <key>StandardOutPath</key>
    <string>/Users/you/Library/Logs/host-updater/service.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/you/Library/Logs/host-updater/service.err.log</string>
  </dict>
</plist>
