{
  "server": {
    "listen_address": "0.0.0.0:8765",
    "bearer_token_file": "/Users/you/Library/Application Support/host-updater/token.txt"
  },
  "paths": {
    "jobs_root": "/Users/you/Library/Application Support/host-updater/jobs",
    "runtime_root": "/Users/you/Library/Application Support/host-updater/runtime"
  },
  "executables": {
    "git": "/usr/bin/git",
    "docker": "/usr/local/bin/docker",
    "zip": "/usr/bin/zip"
  },
  "limits": {
    "max_tail_lines": 10000
  },
  "projects": {
    "{project}": {
      "repo_dir": "/Users/you/src/{project}",
      "git": {
        "allowed_origins": ["origin", "fork"],
        "allowed_branch_regexes": [
          "^[A-Za-z0-9._/-]+$"
        ]
      },
      "build": {
        "cwd": "/Users/you/src/{project}",
        "context_dir": "/Users/you/src/{project}",
        "dockerfile": "/Users/you/src/{project}/Dockerfile",
        "latest_tag": "{image}:latest",
        "commit_tag_prefix": "{image}:git-"
      },
      "compose": {
        "cwd": "/Users/you/src/{project}",
        "files": [
          "/Users/you/src/{project}/docker-compose.yml"
        ],
        "primary_service": "{compose_service}",
        "services": ["{compose_service}"]
      },
      "backup": {
        "sources": [
          "/Users/you/Library/Application Support/{project}"
        ],
        "destination": "/Users/you/Library/Application Support/host-updater/backups",
        "exclude": [
          "node_modules",
          ".git"
        ],
        "symlinks": "store",
        "retain": 5
      }
    }
  },
  "scripts": {
    "rotate-logs": {
      "runner": "/bin/sh",
      "path": "/Users/you/scripts/rotate-logs.sh",
      "cwd": "/Users/you",
      "timeout_seconds": 600
    },
    "db-cleanup": {
      "runner": "/usr/bin/python3",
      "path": "/Users/you/scripts/db_cleanup.py",
      "timeout_seconds": 120
    }
  }
}
